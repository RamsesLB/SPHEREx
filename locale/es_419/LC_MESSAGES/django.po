msgid "%(count)s for this detector"
msgstr "%(count)s en este detector"

msgid "%(size)s × %(size)s"
msgstr "%(size)s × %(size)s"

msgid "0 for this detector"
msgstr "0 en este detector"

msgid "Arcminutes"
msgstr "Minutos de arco"

msgid "Arcseconds"
msgstr "Segundos de arco"

msgid "Base survey"
msgstr "Mapa base"

msgid "Check the coordinates and the cutout size."
msgstr "Revisa las coordenadas y el tamaño del recorte."

msgid "Choose an observation or press play."
msgstr "Elige una observación o presiona reproducir."

msgid "Click the map to copy RA and Dec, then search."
msgstr "Haz clic en el mapa para copiar RA y Dec, y luego busca."

msgid "Collection"
msgstr "Colección"

msgid "Cutout"
msgstr "Recorte"

msgid "Declination"
msgstr "Declinación"

msgid "Degrees"
msgstr "Grados"

msgid "Detector"
msgstr "Detector"

msgid "Detectors %(list)s"
msgstr "Detectores %(list)s"

msgid "Detector %(number)s"
msgstr "Detector %(number)s"

msgid "Detector not identified"
msgstr "Detector no identificado"

msgid "IRSA could not be queried. Try again in a few seconds."
msgstr "No se pudo consultar IRSA. Intenta de nuevo en unos segundos."

msgid "IRSA returned no SPHEREx images for this position in %(collection)s."
msgstr "IRSA no devolvió imágenes SPHEREx para esta posición en %(collection)s."

msgid "In this version the maximum cutout is 1 degree."
msgstr "En esta versión el recorte máximo es 1 grado."

msgid "Language"
msgstr "Idioma"

msgid "Loading FITS…"
msgstr "Cargando FITS…"

msgid "Missing RA and Dec."
msgstr "Faltan RA y Dec."

msgid "Next"
msgstr "Siguiente"

msgid "Accept"
msgstr "Aceptar"

msgid "Close"
msgstr "Cerrar"

msgid "No observations"
msgstr "Sin observaciones"

msgid "No observations for this detector."
msgstr "No hay observaciones de este detector."

msgid "No observations were found for this collection and this detector. Try another detector or another area of the sky."
msgstr "No se encontraron observaciones para esta colección y este detector. Prueba con otro detector o con otra zona del cielo."

msgid "No results."
msgstr "Sin resultados."

msgid "Observations"
msgstr "Observaciones"

msgid "Select all"
msgstr "Seleccionar todas"

msgid "Select at least one observation to play."
msgstr "Selecciona al menos una observación para reproducir."

msgid "Include in playback"
msgstr "Incluir en la reproducción"

msgid "Sum"
msgstr "Suma"

msgid "Sum detectors"
msgstr "Sumar detectores"

msgid "Choose a detector group that shares the same observation. The next step lists those observations so you can keep only the dates you want."
msgstr "Elige un grupo de detectores que comparten la misma observación. El paso siguiente lista esas observaciones para quedarte solo con las fechas que quieras."

msgid "Advanced search"
msgstr "Búsqueda avanzada"

msgid "Each checked release is searched. The sum still stacks only the detectors that share one observation."
msgstr "Se busca cada publicación marcada. La suma sigue apilando solo los detectores que comparten una observación."

msgid "Releases"
msgstr "Publicaciones"

msgid "Select at least one release."
msgstr "Selecciona al menos una publicación."

msgid "Choose observations"
msgstr "Elegir observaciones"

msgid "Choose the observations to include. Each checked observation becomes one summed image. Confirm with none checked to keep every match."
msgstr "Elige las observaciones a incluir. Cada observación marcada se convierte en una imagen sumada. Si confirmas sin marcar ninguna, se conservan todas las que coinciden."

msgid "Date"
msgstr "Fecha"

msgid "Observation"
msgstr "Observación"

msgid "Confirm"
msgstr "Confirmar"

msgid "Detectors %(list)s · %(count)s observations"
msgstr "Detectores %(list)s · %(count)s observaciones"

msgid "Sum results"
msgstr "Resultados de suma"

msgid "%(count)s summed images"
msgstr "%(count)s imágenes sumadas"

msgid "No observation has more than one detector to sum."
msgstr "Ninguna observación tiene más de un detector para sumar."

msgid "Choose which detectors to stack for the same observation. An observation is checked only when it has a row for every detector you pick. Play shows each summed frame as soon as it is ready and keeps two downloads going. A detector that does not cover this position is skipped for that frame."
msgstr "Elige qué detectores apilar para la misma observación. Una observación se marca solo si tiene una fila para cada detector elegido. Play muestra cada frame sumado en cuanto está listo y mantiene dos descargas a la vez. Si un detector no cubre esta posición, ese frame se suma sin él."

msgid "No observation includes every selected detector."
msgstr "Ninguna observación incluye todos los detectores elegidos."

msgid "One detector"
msgstr "Un detector"

msgid "Apply"
msgstr "Aplicar"

msgid "Select at least one detector."
msgstr "Selecciona al menos un detector."

msgid "%(count)s observations ready to sum. Press play."
msgstr "%(count)s observaciones listas para sumar. Presiona reproducir."

msgid "Summing detectors for %(count)s observations."
msgstr "Sumando los detectores de %(count)s observaciones."

msgid "Choose a summed image."
msgstr "Elige una imagen sumada."

msgid "Only this SPHEREx release is searched. New releases appear in this list."
msgstr "Solo se busca esta publicación de SPHEREx. Las publicaciones nuevas aparecen en esta lista."

msgid "Pause"
msgstr "Pausa"

msgid "Play"
msgstr "Reproducir"

msgid "Preview zone"
msgstr "Previsualizar zona"

msgid "RA and Dec could not be read."
msgstr "No se pudo leer RA y Dec."

msgid "Previous"
msgstr "Anterior"

msgid "Quick Release %(number)s (deep survey)"
msgstr "Quick Release %(number)s (sondeo profundo)"

msgid "Quick Release %(number)s (wide survey)"
msgstr "Quick Release %(number)s (sondeo amplio)"

msgid "Data Release %(number)s"
msgstr "Data Release %(number)s"

msgid "Data Release %(number)s (cube)"
msgstr "Data Release %(number)s (cubo)"

msgid "Data Release %(number)s (deep survey)"
msgstr "Data Release %(number)s (sondeo profundo)"

msgid "RA and Dec could not be read. Use 08h55m10.831s and -7d14m42.53s, or decimal degrees."
msgstr "No se pudieron leer RA y Dec. Usa 08h55m10.831s y -7d14m42.53s, o grados decimales."

msgid "RA or Dec is out of range."
msgstr "RA o Dec está fuera de rango."

msgid "Right ascension"
msgstr "Ascensión recta"

msgid "Search"
msgstr "Buscar"

msgid "Searching…"
msgstr "Buscando…"

msgid "Search a sky position to play the sequence."
msgstr "Busca un punto del cielo para reproducir la secuencia."

msgid "Search a sky position to see the sequence."
msgstr "Busca un punto del cielo para ver la secuencia."

msgid "Showing the %(count)s most recent observations."
msgstr "Se muestran las %(count)s observaciones más recientes."

msgid "Side"
msgstr "Lado"

msgid "SPHEREx cutout"
msgstr "Recorte SPHEREx"

msgid "The square on the map is the cutout size; the number uses the unit next to Side. The IRSA search looks for images within 1 arcsec of the point. Maximum side is 1 degree."
msgstr "El cuadrado en el mapa es el tamaño del recorte; el número usa la unidad junto a Lado. La búsqueda en IRSA busca imágenes a 1 arcsec del punto. El lado máximo es 1 grado."

msgid "1. Preview"
msgstr "1. Previsualizar"

msgid "2. Search SPHEREx data"
msgstr "2. Buscar datos SPHEREx"

msgid "The FITS file could not be downloaded from IRSA."
msgstr "No se pudo descargar el archivo FITS desde IRSA."

msgid "The FITS file has no IMAGE extension."
msgstr "El archivo FITS no tiene la extensión IMAGE."

msgid "The IMAGE extension is empty."
msgstr "La extensión IMAGE está vacía."

msgid "The cutout could not be generated."
msgstr "No se pudo generar el recorte."

msgid "The cutout could not be loaded."
msgstr "No se pudo cargar el recorte."

msgid "The cutout size is not a number."
msgstr "El tamaño del recorte no es un número."

msgid "The cutout size must be greater than zero."
msgstr "El tamaño del recorte debe ser mayor que cero."

msgid "%(done)s / %(total)s · %(eta)s left"
msgstr "%(done)s / %(total)s · faltan %(eta)s"

msgid "The cutout was empty."
msgstr "El recorte llegó vacío."

msgid "Timing the first image…"
msgstr "Midiendo la primera imagen…"

msgid "The first search and each new FITS file can take a while."
msgstr "La primera búsqueda y cada archivo FITS nuevo pueden tardar."

msgid "The map could not start. You can still type coordinates."
msgstr "El mapa no pudo iniciarse. Igual puedes escribir las coordenadas."

msgid "This observation does not cover the requested position."
msgstr "Esta observación no cubre la posición pedida."

msgid "Unit"
msgstr "Unidad"

msgid "Unknown size unit."
msgstr "Unidad de tamaño desconocida."

msgid "Save object"
msgstr "Guardar objeto"

msgid "Objects"
msgstr "Objetos"

msgid "Saved objects"
msgstr "Objetos guardados"

msgid "Name"
msgstr "Nombre"

msgid "Cancel"
msgstr "Cancelar"

msgid "Save"
msgstr "Guardar"

msgid "Edit"
msgstr "Editar"

msgid "Edit object"
msgstr "Editar objeto"

msgid "Delete"
msgstr "Eliminar"

msgid "Add object"
msgstr "Agregar objeto"

msgid "No saved objects yet."
msgstr "Todavía no hay objetos guardados."

msgid "Enter a name."
msgstr "Escribe un nombre."

msgid "The object list is full."
msgstr "La lista de objetos está llena."

msgid "Local database"
msgstr "Base local"

msgid "Nothing saved for this point"
msgstr "Nada guardado para este punto"

msgid "Checking IRSA…"
msgstr "Consultando IRSA…"

msgid "IRSA did not respond"
msgstr "IRSA no respondió"

msgid "No images in this collection"
msgstr "Sin imágenes en esta colección"

msgid "No new observations"
msgstr "Sin observaciones nuevas"

msgid "Showing saved observations. A cutout still needs the FITS file."
msgstr "Mostrando observaciones guardadas. El recorte todavía necesita el archivo FITS."

msgid "%(count)s saved observation"
msgid_plural "%(count)s saved observations"
msgstr[0] "%(count)s observación guardada"
msgstr[1] "%(count)s observaciones guardadas"

msgid "%(count)s new observation"
msgid_plural "%(count)s new observations"
msgstr[0] "%(count)s observación nueva"
msgstr[1] "%(count)s observaciones nuevas"
